# Razorpay ACP Checkout Adapter Environment Variables

# App Environment (development, testing, production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Razorpay Test Mode Credentials (get from dashboard.razorpay.com or use placeholder for offline test)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# Google Cloud Firestore Configuration
FIRESTORE_PROJECT_ID=razorpay-acp-test
FIRESTORE_DATABASE=(default)
# Optional if running locally with ADC or service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Protocol Configuration
ACP_SPEC_VERSION=2026-04-17
MERCHANT_NAME="Razorpay ACP Merchant Store"

# Outbound HMAC-SHA256 Webhook Configuration (Optional callback target)
# WEBHOOK_TARGET_URL=https://your-domain.com/api/acp-webhooks
WEBHOOK_SECRET=razorpay_acp_webhook_secret_2026

# Rate Limiting (Sliding Window in-memory default)
RATE_LIMIT_PER_MINUTE=120

# Frontend Configuration (for Next.js dashboard)
NEXT_PUBLIC_API_URL=http://localhost:8000

