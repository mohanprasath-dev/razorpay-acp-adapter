            "title": "Refund Id"
          }
        },
        "type": "object",
        "title": "PaymentProvider"
      },
      "Product": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "price": {
            "type": "number",
            "minimum": 0.0,
            "title": "Price",
            "description": "Price must be non-negative"
