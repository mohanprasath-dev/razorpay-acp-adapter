            "title": "Anomaly Score",
            "default": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "totals"
        ],
        "title": "CheckoutSession"
      },
      "CreateCheckoutSessionRequest": {
        "properties": {
          "line_items": {
            "items": {
              "$ref": "#/components/schemas/RawLineItemInput"
            },
